{
  "name": "Оффлайн-плеер",
  "short_name": "Плеер",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#171830",
  "theme_color": "#171830",
  "icons": [
    {
      "src": "pc-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "pc-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "pc-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "pc-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            ".mp3",
            ".m4a",
            ".m4b",
            ".aac",
            ".flac",
            ".wav",
            ".ogg",
            ".oga",
            ".opus",
            ".mid",
            ".midi",
            ".aif",
            ".aiff",
            ".wma"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/mp4": [
          ".m4a",
          ".m4b"
        ],
        "audio/aac": [
          ".aac"
        ],
        "audio/flac": [
          ".flac"
        ],
        "audio/wav": [
          ".wav"
        ],
        "audio/ogg": [
          ".ogg",
          ".oga",
          ".opus"
        ],
        "audio/midi": [
          ".mid",
          ".midi"
        ],
        "audio/aiff": [
          ".aif",
          ".aiff"
        ]
      }
    }
  ]
}